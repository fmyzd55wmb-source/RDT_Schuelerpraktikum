const localizedToGerman = new Map<string, string>([
  ...Object.entries(germanToEnglish).map(([german, translated]) => [translated, german] as const),
  ...Object.entries(germanToSpanish).map(([german, translated]) => [translated, german] as const),
  ...Object.entries(germanToFrench).map(([german, translated]) => [translated, german] as const),
]);
function translateText(value: string, language: Language): string {
  const germanValue = localizedToGerman.get(value) ?? value;
  if (language === "en") return germanToEnglish[germanValue] ?? germanValue;
  if (language === "es") return germanToSpanish[germanValue] ?? germanValue;
  if (language === "fr") return germanToFrench[germanValue] ?? germanValue;
  return germanValue;
}
function localizeQuestion(question: Question, language: Language): Question {
  if (language === "de") return question;
  if (question.kind === "multiple-choice") return { ...question, question: translateText(question.question, language), answers: question.answers.map((answer) => ({ ...answer, text: translateText(answer.text, language) })) };
  if (question.kind === "text") return { ...question, question: translateText(question.question, language), placeholder: translateText(question.placeholder, language), expectedAnswers: question.expectedAnswers.map((answer) => translateText(answer, language)), feedbackAnswer: translateText(question.feedbackAnswer, language) };
  if (question.kind === "number") return { ...question, question: translateText(question.question, language), placeholder: translateText(question.placeholder, language), unit: translateText(question.unit, language), feedbackAnswer: translateText(question.feedbackAnswer, language) };
  return { ...question, question: translateText(question.question, language) };
}
function localizeQuiz(quiz: QuizDefinition, language: Language): QuizDefinition {
  return { ...quiz, title: translateText(quiz.title, language), description: translateText(quiz.description, language), questions: quiz.questions.map((question) => localizeQuestion(question, language)) };
}

