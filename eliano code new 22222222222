function shuffle<T>(items: T[]): T[] {
  return [...items].sort(() => Math.random() - 0.5);
}

function createQuiz(quiz: QuizDefinition): Question[] {
  const source = quiz.questions;
  const ordered = quiz.id === "quiz1" ? [source[0], ...shuffle(source.slice(1))] : shuffle(source);
  return ordered.map((question) => question.kind === "multiple-choice" ? { ...question, answers: shuffle(question.answers) } : { ...question });
}

function formatElapsed(ms: number): string {
  const totalSeconds = Math.floor(ms / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return `${minutes}:${seconds}`;
}

function normalizeAnswer(value: string): string {
  return value.trim().toLocaleLowerCase("de-DE").replace(/[.,!?]/g, "");
}

function emptyDraftQuestion(): DraftQuestion {
  return { kind: "multiple-choice", question: "", answers: ["", "", "", ""], correctIndex: 0, expectedAnswer: "", expectedNumber: "", unit: "", expectedBoolean: true };
}

function draftFromQuestion(question: Question): DraftQuestion {
  if (question.kind === "true-false") {
    return { kind: question.kind, question: question.question, answers: ["", "", "", ""], correctIndex: 0, expectedAnswer: "", expectedNumber: "", unit: "", expectedBoolean: question.expectedBoolean };
  }
  if (question.kind === "multiple-choice") {
    return { kind: question.kind, question: question.question, answers: question.answers.map((answer) => answer.text), correctIndex: Math.max(0, question.answers.findIndex((answer) => answer.correct)), expectedAnswer: "", expectedNumber: "", unit: "", expectedBoolean: true };
  }
  if (question.kind === "text") {
    return { kind: question.kind, question: question.question, answers: ["", "", "", ""], correctIndex: 0, expectedAnswer: question.expectedAnswers[0] ?? "", expectedNumber: "", unit: "", expectedBoolean: true };
  }
  return { kind: question.kind, question: question.question, answers: ["", "", "", ""], correctIndex: 0, expectedAnswer: "", expectedNumber: String(question.expectedNumber), unit: question.unit, expectedBoolean: true };
}

