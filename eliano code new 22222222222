  const [authError, setAuthError] = useState("");
  const [user, setUser] = useState<User | null>(null);
  const [loading, setLoading] = useState(false);
  const [started, setStarted] = useState(false);
  const [finished, setFinished] = useState(false);
  const [availableQuizzes, setAvailableQuizzes] = useState<QuizDefinition[]>(() => Object.values(systemQuizzes).map((quiz) => localizeQuiz(quiz, "en")));
  const [activeQuizId, setActiveQuizId] = useState<QuizId>("quiz1");
  const [rankingQuizId, setRankingQuizId] = useState<QuizId>("quiz1");
  const [rankingView, setRankingView] = useState<"global" | "mine">("global");
  const [questions, setQuestions] = useState<Question[]>(() => createQuiz(localizeQuiz(systemQuizzes.quiz1, "en")));
  const [current, setCurrent] = useState(0);
  const [answersByQuestion, setAnswersByQuestion] = useState<Array<boolean | null>>(() => Array(quiz1Questions.length).fill(null));
  const [answerDraft, setAnswerDraft] = useState("");
  const [answerError, setAnswerError] = useState("");
  const [feedback, setFeedback] = useState<Feedback | null>(null);
  const [darkMode, setDarkMode] = useState(false);
  const [ranking, setRanking] = useState<QuizResult[]>([]);
  const [bestByQuiz, setBestByQuiz] = useState<Partial<Record<QuizId, QuizResult | null>>>({});
  const [savedResult, setSavedResult] = useState<QuizResult | null>(null);
  const [showRanking, setShowRanking] = useState(false);
  const [showAdmin, setShowAdmin] = useState(false);
  const [adminUsers, setAdminUsers] = useState<AdminUser[]>([]);
  const [showQuizCreator, setShowQuizCreator] = useState(false);
  const [editingQuizId, setEditingQuizId] = useState<QuizId | null>(null);
  const [quizCreateError, setQuizCreateError] = useState("");
  const [quizCreating, setQuizCreating] = useState(false);
  const [newQuizTitle, setNewQuizTitle] = useState("");
  const [newQuizDescription, setNewQuizDescription] = useState("");
  const [draftQuestions, setDraftQuestions] = useState<DraftQuestion[]>([]);
  const [elapsedMs, setElapsedMs] = useState(0);
  const quizStartedAt = useRef<number | null>(null);
  const elapsedRef = useRef(0);

  const activeQuiz = availableQuizzes.find((quiz) => quiz.id === activeQuizId) ?? systemQuizzes[activeQuizId] ?? systemQuizzes.quiz1;
  const question = questions[current] ?? questions[0];
  const score = answersByQuestion.filter(Boolean).length;
  const isDevMode = name.trim() === "1234567899";
  const showFoundingVideo = activeQuizId === "quiz1" && question?.id === "founding";
  const progress = finished ? 100 : ((current + (feedback ? 1 : 0)) / questions.length) * 100;

  useEffect(() => {
    document.documentElement.lang = language;
  }, [language]);

  useEffect(() => {
    void fetch("/api/quizzes").then((response) => response.json()).then((data: { quizzes?: QuizDefinition[] }) => {
      const serverQuizzes = data.quizzes ?? [];
      const visibleSystemQuizzes = serverQuizzes
        .filter((quiz) => quiz.id === "quiz1" || quiz.id === "quiz2")
        .map((quiz) => ({ ...systemQuizzes[quiz.id], ...(quiz.questions?.length ? quiz : {}), isSystem: true }));
      const customQuizzes = serverQuizzes.filter((quiz) => quiz.id !== "quiz1" && quiz.id !== "quiz2");
      setAvailableQuizzes([...visibleSystemQuizzes, ...customQuizzes.map((quiz) => ({ ...localizeQuiz(quiz, language), isSystem: false }))].map((quiz) => localizeQuiz(quiz, language)));
    }).catch(() => undefined);
  }, [language]);

  useEffect(() => {
    void fetch("/api/auth/me").then((response) => response.json()).then((data: { user: User | null }) => {
      if (data.user) {
        setUser(data.user);
        setName(data.user.username);
      }
    }).catch(() => undefined);
  }, []);

  // Lädt die globalen Bestwerte für die Karten im Dashboard.
  useEffect(() => {
    let cancelled = false;
    async function loadBestResults() {
      const responses = await Promise.all(availableQuizzes.map((quiz) => fetch(`/api/leaderboard?quizId=${encodeURIComponent(quiz.id)}&view=global`)));
      const data = await Promise.all(responses.map((response) => response.json() as Promise<{ quizId?: string; myResult?: QuizResult | null }>));
      if (cancelled) return;
      const nextBest: Partial<Record<QuizId, QuizResult | null>> = {};
      data.forEach((item) => {
        if (item.quizId) nextBest[item.quizId] = item.myResult ?? null;
      });
      setBestByQuiz(nextBest);
    }
    void loadBestResults().catch(() => undefined);
    return () => { cancelled = true; };
  }, [availableQuizzes, user]);

  // Lädt je nach Umschalter entweder die globale Rangliste oder die eigene Historie.
  useEffect(() => {
    if (!showRanking) return;
    let cancelled = false;
    async function loadRanking() {
      const response = await fetch(`/api/leaderboard?quizId=${encodeURIComponent(rankingQuizId)}&view=${rankingView}`);
      const data = await response.json() as { results?: QuizResult[]; error?: string };
      if (cancelled) return;
      if (!response.ok) {
        setRanking([]);
        setAuthError(translateText(data.error ?? "Die Rangliste konnte nicht geladen werden.", language));
        return;
      }
      setRanking(data.results ?? []);
      setAuthError("");
    }
    void loadRanking().catch(() => setAuthError(translateText("Die Rangliste konnte nicht geladen werden.", language)));
    return () => { cancelled = true; };
      }, [language, rankingQuizId, rankingView, showRanking]);

  useEffect(() => {
    if (!started || finished) return;
    // Der Startzeitpunkt wird im Effekt gesetzt, damit Rendern rein und stabil bleibt.
    if (quizStartedAt.current === null) quizStartedAt.current = Date.now();
    const timer = window.setInterval(() => {
      const nextElapsedMs = Date.now() - (quizStartedAt.current ?? Date.now());
      elapsedRef.current = nextElapsedMs;
      setElapsedMs(nextElapsedMs);
    }, 100);
    return () => window.clearInterval(timer);
  }, [started, finished]);

  function beginQuiz(quizId: QuizId) {
    const quiz = availableQuizzes.find((item) => item.id === quizId) ?? systemQuizzes[quizId];
    if (!quiz) return;
    const nextQuestions = createQuiz(localizeQuiz(quiz, language));
    setActiveQuizId(quizId);
    setQuestions(nextQuestions);
    setCurrent(0);
    setAnswersByQuestion(Array(nextQuestions.length).fill(null));
    setAnswerDraft("");
    setAnswerError("");
    setFeedback(null);
    setFinished(false);
    setSavedResult(null);
    setShowRanking(false);
    setElapsedMs(0);
    elapsedRef.current = 0;
    quizStartedAt.current = null;
    setStarted(true);
  }

  function updateDraftQuestion(index: number, changes: Partial<DraftQuestion>) {
    setDraftQuestions((previous) => previous.map((question, questionIndex) => questionIndex === index ? { ...question, ...changes } : question));
  }

  function updateDraftAnswer(questionIndex: number, answerIndex: number, value: string) {
    setDraftQuestions((previous) => previous.map((question, index) => {
      if (index !== questionIndex) return question;
      const answers = [...question.answers];
      answers[answerIndex] = value;
      return { ...question, answers };
    }));
  }

  function editQuiz(quiz: QuizDefinition) {
    setEditingQuizId(quiz.id);
    setNewQuizTitle(quiz.title);
    setNewQuizDescription(quiz.description);
    setDraftQuestions(quiz.questions.map(draftFromQuestion));
    setQuizCreateError("");
    setShowQuizCreator(true);
  }

  async function deleteCustomQuiz(quizId: QuizId) {
    const quiz = availableQuizzes.find((item) => item.id === quizId);
    if (!quiz || !window.confirm(language === "en" ? `Do you really want to delete the quiz “${quiz.title}”? High scores will also be removed.` : `Möchtest du das Quiz „${quiz.title}“ wirklich löschen? Highscores werden ebenfalls entfernt.`)) return;
    try {
      const response = await fetch("/api/quizzes", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ quizId }) });
      const data = await response.json().catch(() => ({})) as { error?: string };
      if (!response.ok) {
        setQuizCreateError(data.error ?? "Das Quiz konnte nicht gelöscht werden.");
        return;
      }
      setAvailableQuizzes((previous) => previous.filter((item) => item.id !== quizId));
      setBestByQuiz((previous) => { const next = { ...previous }; delete next[quizId]; return next; });
      if (rankingQuizId === quizId) setRankingQuizId("quiz1");
      if (activeQuizId === quizId) setActiveQuizId("quiz1");
      if (editingQuizId === quizId) { setShowQuizCreator(false); setEditingQuizId(null); }
    } catch {
      setQuizCreateError(t("Der Server ist momentan nicht erreichbar."));
    }
  }

  async function saveNewQuiz(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setQuizCreateError("");
    if (!newQuizTitle.trim() || !newQuizDescription.trim() || draftQuestions.length === 0) {
      setQuizCreateError(t("Bitte gib Titel, Beschreibung und mindestens eine Frage ein."));
      return;
    }
    setQuizCreating(true);
    try {
      const response = await fetch("/api/quizzes", {
        method: editingQuizId ? "PUT" : "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          ...(editingQuizId ? { quizId: editingQuizId } : {}),
          title: newQuizTitle,
          description: newQuizDescription,
          questions: draftQuestions.map((question) => question.kind === "multiple-choice"
            ? { kind: question.kind, question: question.question, answers: question.answers, correctIndex: question.correctIndex }
            : question.kind === "text"
              ? { kind: question.kind, question: question.question, expectedAnswer: question.expectedAnswer }
              : question.kind === "true-false"
                ? { kind: question.kind, question: question.question, expectedBoolean: question.expectedBoolean }
                : { kind: question.kind, question: question.question, expectedNumber: Number(question.expectedNumber), unit: question.unit }),
        }),
      });
      const data = await response.json() as { quiz?: QuizDefinition; error?: string };
      if (!response.ok || !data.quiz) {
        setQuizCreateError(t(data.error ?? "Das Quiz konnte nicht gespeichert werden."));
        return;
      }
      const savedQuiz = data.quiz as QuizDefinition;
      setAvailableQuizzes((previous) => editingQuizId ? previous.map((quiz) => quiz.id === savedQuiz.id ? savedQuiz : quiz) : [...previous, savedQuiz]);
      setNewQuizTitle("");
      setNewQuizDescription("");
      setDraftQuestions([]);
      setEditingQuizId(null);
      setShowQuizCreator(false);
    } catch {
      setQuizCreateError(t("Der Server ist momentan nicht erreichbar."));
    } finally {
      setQuizCreating(false);
    }
  }

  useEffect(() => {
    const params = new URLSearchParams(window.location.search);
    const token = params.get("resetToken");
    if (token) {
      setResetToken(token);
      setShowPasswordReset(true);
    }
  }, []);

  async function requestPasswordReset(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setResetMessage("");
    const response = await fetch("/api/auth/password-reset/request", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: resetEmail, language }),
    });
    const data = await response.json().catch(() => ({})) as { message?: string; error?: string };
    setResetMessage(data.error ?? "Ein Link zum Zurücksetzen wurde versendet.");
  }

  async function confirmPasswordReset(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    setResetMessage("");
    const response = await fetch("/api/auth/password-reset/confirm", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ token: resetToken, password: resetPassword }),
    });
    const data = await response.json().catch(() => ({})) as { message?: string; error?: string };
    setResetMessage(data.error ?? data.message ?? "Das Passwort wurde erfolgreich geändert.");
    if (response.ok) {
      setResetToken("");
      setResetPassword("");
    }
  }

  // Anmeldung und Registrierung führen bewusst nur zum Dashboard, nicht direkt zum Quiz.
  async function handleAuth(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const cleanName = name.trim();
    if (!cleanName || cleanName.length > 25) {
      setAuthError(t("Der Benutzername muss 1 bis 25 Zeichen lang sein."));
      return;
    }
    if (!password) {
      setAuthError(t("Bitte gib dein Passwort ein."));
      return;
    }
    if (authMode === "register" && !email.trim()) {
      setAuthError(t("Bitte gib eine gültige E-Mail-Adresse ein."));
      return;
    }

    setLoading(true);
    setAuthError("");
    try {
      const response = await fetch(`/api/auth/${authMode}`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ username: cleanName, email: email.trim(), password }),
      });
      const data = await response.json() as { user?: User; error?: string };
      if (!response.ok || !data.user) {
        setAuthError(t(data.error ?? "Die Anmeldung ist fehlgeschlagen."));
        return;
      }
      setUser(data.user);
      setName(data.user.username);
      setPassword("");
    } catch {
      setAuthError(t("Der Server ist momentan nicht erreichbar."));
    } finally {
      setLoading(false);
    }
  }

  async function logout() {
    await fetch("/api/auth/logout", { method: "POST" }).catch(() => undefined);
    setUser(null);
    setStarted(false);
    setFinished(false);
    setSavedResult(null);
    setShowRanking(false);
    setShowAdmin(false);
    setPassword("");
    setShowPassword(false);
  }

  async function deleteAccount() {
    if (!window.confirm(t("Möchtest du deinen Account wirklich löschen? Deine Highscore-Daten werden ebenfalls entfernt."))) return;
    const response = await fetch("/api/auth/delete", { method: "DELETE" });
    if (!response.ok) {
      setAuthError("Der Account konnte nicht gelöscht werden.");
      return;
    }
    setUser(null);
    setStarted(false);
    setFinished(false);
    setSavedResult(null);
    setShowAdmin(false);
    setPassword("");
  }

  async function loadAdminUsers() {
    const response = await fetch("/api/admin/users");
    const data = await response.json() as { users?: AdminUser[]; error?: string };
    if (!response.ok) {
      setAuthError(t(data.error ?? "Die Admin-Daten konnten nicht geladen werden."));
      return;
    }
    setAdminUsers(data.users ?? []);
    setShowAdmin(true);
  }

  async function deleteAdminUser(userId: number) {
    if (!window.confirm(t("Diesen Benutzer wirklich löschen?"))) return;
    const response = await fetch("/api/admin/users", { method: "DELETE", headers: { "Content-Type": "application/json" }, body: JSON.stringify({ userId }) });
    if (!response.ok) {
      const data = await response.json().catch(() => ({})) as { error?: string };
      setAuthError(data.error ?? "Der Benutzer konnte nicht gelöscht werden.");
      return;
    }
    setAdminUsers((users) => users.filter((item) => item.id !== userId));
    setRanking((items) => items.filter((item) => item.id !== userId));
    if (user?.id === userId) {
      setUser(null);
      setShowAdmin(false);
      setStarted(false);
      setFinished(false);
      setSavedResult(null);
      setPassword("");
    }
  }

  async function submitScore(finalScore: number, finalElapsedMs: number) {
    try {
      const response = await fetch("/api/quiz/complete", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ quizId: activeQuizId, correct: finalScore, total: questions.length, elapsedMs: finalElapsedMs }),
      });
      const data = await response.json() as { result?: Omit<QuizResult, "percentage" | "rank">; rank?: number | null; leaderboard?: QuizResult[]; error?: string };
      if (!response.ok || !data.result) {
        setAuthError(t(data.error ?? "Das Ergebnis konnte nicht gespeichert werden."));
        return;
      }
      const result = { ...data.result, percentage: Math.round((data.result.correct / data.result.total) * 100), rank: data.rank ?? 0 };
      setSavedResult(result);
      setBestByQuiz((previous) => ({ ...previous, [activeQuizId]: result }));
      if (data.leaderboard) setRanking(data.leaderboard);
    } catch {
      setAuthError(t("Das Ergebnis konnte nicht gespeichert werden."));
    }
  }

  // Speichert eine Antwort und zeigt bei allen Fragetypen dasselbe Feedback an.
  function recordAnswer(isCorrect: boolean, expected: string) {
    setAnswersByQuestion((previousAnswers) => {
      const updatedAnswers = [...previousAnswers];
      updatedAnswers[current] = isCorrect;
      return updatedAnswers;
    });
    setFeedback({ correct: isCorrect, expected });
    setAnswerError("");
  }

  function chooseAnswer(answer: Answer) {
    if (feedback) return;
    recordAnswer(answer.correct, answer.text);
  }

  function chooseBooleanAnswer(value: boolean) {
    if (feedback || question.kind !== "true-false") return;
    recordAnswer(value === question.expectedBoolean, question.expectedBoolean ? t("Wahr") : t("Falsch"));
  }

  function submitFreeAnswer(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    if (feedback) return;
    setAnswerError("");
    if (!answerDraft.trim()) {
      setAnswerError(t("Bitte gib eine Antwort ein."));
      return;
    }
    if (question.kind === "text") {
      const normalized = normalizeAnswer(answerDraft);
      const isCorrect = question.expectedAnswers.some((expected) => normalizeAnswer(expected) === normalized);
      recordAnswer(isCorrect, question.feedbackAnswer);
      return;
    }
    if (question.kind === "number") {
      const isInteger = /^-?\d+$/.test(answerDraft.trim());
      const isCorrect = isInteger && Number(answerDraft.trim()) === question.expectedNumber;
      recordAnswer(isCorrect, question.feedbackAnswer);
    }
  }

  // Erst nach dem sichtbaren Feedback geht es zur nächsten Frage oder zum Ergebnis.
  function continueQuiz() {
    if (!feedback) return;
    if (current === questions.length - 1) {
      const finalElapsedMs = elapsedRef.current;
      setElapsedMs(finalElapsedMs);
      setFinished(true);
      void submitScore(score, finalElapsedMs);
      return;
    }
    setCurrent((value) => value + 1);
    setAnswerDraft("");
    setAnswerError("");
    setFeedback(null);
  }

  function selectLanguage(nextLanguage: Language) {
    setLanguage(nextLanguage);
    setShowLanguageMenu(false);
    setStarted(false);
    setFinished(false);
    setShowRanking(false);
    setShowAdmin(false);
    setFeedback(null);
    setAvailableQuizzes((quizzes) => quizzes.map((quiz) => quiz.isSystem ? localizeQuiz(systemQuizzes[quiz.id] ?? quiz, nextLanguage) : quiz));
  }

  function backToDashboard() {
    setStarted(false);
    setFinished(false);
    setSavedResult(null);
    setShowRanking(false);
    setFeedback(null);
    elapsedRef.current = 0;
    quizStartedAt.current = null;
  }

  const pageBackground = darkMode ? "bg-[#101820] text-slate-100" : "bg-[#f4f7fa] text-[#172b4d]";
  const cardBackground = darkMode ? "border-slate-700 bg-slate-900/95" : "border-slate-200 bg-white";
  const mutedText = darkMode ? "text-slate-300" : "text-slate-600";
  const answerColors = darkMode
    ? ["border-blue-500/50 bg-blue-500/10 hover:bg-blue-500/20", "border-red-400/50 bg-red-400/10 hover:bg-red-400/20", "border-yellow-400/50 bg-yellow-400/10 hover:bg-yellow-400/20", "border-emerald-400/50 bg-emerald-400/10 hover:bg-emerald-400/20"]
    : ["border-blue-200 bg-blue-50 hover:bg-blue-100", "border-red-200 bg-red-50 hover:bg-red-100", "border-yellow-200 bg-yellow-50 hover:bg-yellow-100", "border-emerald-200 bg-emerald-50 hover:bg-emerald-100"];
  const answerLetters = ["A", "B", "C", "D"];

  return (
    <main className={`relative min-h-screen overflow-x-hidden transition-colors duration-300 ${pageBackground}`}>
      <div className="pointer-events-none absolute inset-0 opacity-60" aria-hidden="true"><div className="absolute -left-24 top-36 h-64 w-64 rounded-full border-[42px] border-red-500/60 [clip-path:inset(0_0_50%_0)] -rotate-12" /><div className="absolute -right-20 bottom-24 h-72 w-72 rounded-full border-[46px] border-yellow-400/60 [clip-path:inset(50%_0_0_0)] rotate-12" /><div className="absolute right-[12%] top-24 h-28 w-28 rotate-12 rounded-[42%_58%_65%_35%] border-[20px] border-blue-500/25" /></div>

      <header className={`relative z-30 flex w-full items-center justify-between border-b px-5 py-4 shadow-sm lg:px-10 ${darkMode ? "border-slate-700 bg-[#101820]" : "border-slate-200 bg-white"}`}>
        <div className="flex items-center gap-4"><Image src="/roche-logo.png" alt="Roche" width={150} height={60} priority unoptimized className="h-9 w-28 object-contain" /><span className={`hidden border-l pl-3 text-[10px] font-semibold tracking-[0.16em] sm:block ${mutedText}`}>DIAGNOSTICS &amp; PHARMA</span></div>
        <div className="flex items-center gap-2"><button type="button" onClick={() => setShowRanking((value) => !value)} aria-pressed={showRanking} className={`rounded-lg border px-3 py-2 text-xs font-semibold transition hover:border-blue-700 hover:text-blue-700 ${darkMode ? "border-slate-600 text-slate-200" : "border-slate-200 text-slate-700"}`}>{t("Rangliste")}</button><div className="relative"><button type="button" onClick={() => setShowLanguageMenu((value) => !value)} className={`inline-flex h-9 w-12 items-center justify-center rounded-lg border text-lg leading-none transition hover:border-blue-700 hover:text-blue-700 ${darkMode ? "border-slate-600 text-slate-200" : "border-slate-200 text-slate-700"}`} aria-label={languageMenuLabel} aria-expanded={showLanguageMenu} title={languageMenuLabel}>🌐</button>{showLanguageMenu && <div className={`absolute right-0 top-11 z-20 grid min-w-36 gap-1 rounded-xl border p-2 shadow-xl ${darkMode ? "border-slate-600 bg-slate-800" : "border-slate-200 bg-white"}`}><button type="button" onClick={() => selectLanguage("de")} className="rounded-lg px-3 py-2 text-left text-sm font-semibold hover:bg-slate-100">Deutsch</button><button type="button" onClick={() => selectLanguage("en")} className="rounded-lg px-3 py-2 text-left text-sm font-semibold hover:bg-slate-100">English</button><button type="button" onClick={() => selectLanguage("es")} className="rounded-lg px-3 py-2 text-left text-sm font-semibold hover:bg-slate-100">Español</button><button type="button" onClick={() => selectLanguage("fr")} className="rounded-lg px-3 py-2 text-left text-sm font-semibold hover:bg-slate-100">Français</button></div>}</div><div className={`hidden text-xs font-semibold uppercase tracking-[0.18em] sm:block ${mutedText}`}>{t("Wissenstest")} <span className="ml-2 inline-block h-2 w-2 rounded-full bg-emerald-500" /></div></div>
      </header>

      <section className="relative z-10 mx-auto flex min-h-[calc(100vh-104px)] w-full max-w-6xl items-center justify-center px-6 pb-12 pt-8 lg:px-10">
        {showRanking ? (
          <section className={`w-full max-w-3xl rounded-[2rem] border p-8 shadow-2xl md:p-12 ${cardBackground}`}>
