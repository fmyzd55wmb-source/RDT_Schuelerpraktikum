`} aria-label={t("Antwort eingeben")} /><button type="submit" disabled={Boolean(feedback)} className="rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white disabled:opacity-60">{t("Prüfen")}</button></form>}
              {answerError && <p className="mt-3 text-sm font-medium text-red-600">{t(answerError)}</p>}
              {feedback && <div className={`mt-8 rounded-2xl border p-5 ${feedback.correct ? "border-emerald-300 bg-emerald-50 text-emerald-900" : "border-red-300 bg-red-50 text-red-900"}`} role="status"><p className="font-bold">{feedback.correct ? t("Richtig!") : t("Noch nicht richtig.")}</p>{!feedback.correct && <p className="mt-1 text-sm">{t("Richtige Antwort:")} {feedback.expected}</p>}<button type="button" onClick={continueQuiz} className="mt-4 rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white">{current === questions.length - 1 ? t("Ergebnis anzeigen") : t("Weiter")} <span aria-hidden="true">→</span></button></div>}
              <div className={`mt-8 flex flex-col gap-4 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between ${darkMode ? "border-slate-700 text-slate-300" : "border-slate-200 text-slate-600"}`}><span>{feedback ? t("Prüfe dein Feedback und fahre dann fort.") : question.kind === "multiple-choice" ? t("Wähle eine Antwort aus.") : question.kind === "true-false" ? t("Wähle Wahr oder Falsch aus.") : t("Gib deine Antwort ein und prüfe sie.")}</span><button type="button" onClick={backToDashboard} className="font-semibold text-blue-700 transition hover:text-blue-900">← {t("Dashboard")}</button></div>
            </>}
          </div>
        )}
      </section>

      <footer className={`relative z-10 mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-6 pb-6 text-xs ${mutedText} lg:px-10`}><span>{t("Roche Wissenstest")}</span><span>Doing now what patients need next.</span><div className="flex items-center gap-4"><button type="button" onClick={() => setDarkMode((value) => !value)} className="font-semibold transition hover:text-blue-700" aria-label={darkMode ? t("Light mode aktivieren") : t("Dark mode aktivieren")}>{darkMode ? "☀ Light mode" : "☾ Night mode"}</button></div></footer>
    </main>
  );
}
