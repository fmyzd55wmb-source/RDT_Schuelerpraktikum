"use client";

import Image from "next/image";
import { FormEvent, useEffect, useMemo, useState } from "react";

// Schlüssel für die Namensliste im lokalen Browser-Speicher.
const USED_NAMES_KEY = "roche-quiz-used-names";

// Eine Antwort enthält den sichtbaren Text und die Information, ob sie richtig ist.
type Answer = { text: string; correct: boolean };
// Eine Frage besteht aus dem Fragetext und vier Antwortmöglichkeiten.
type Question = { question: string; answers: Answer[] };
type QuizResult = { id: string; name: string; correct: number; total: number; percentage: number; completedAt: string; rank: number };

const RESULTS_KEY = "roche-quiz-results-v1";

// Feste Fragenbasis des Wissenstests.
const sourceQuestions: Question[] = [
  { question: "Wann und wo wurde Roche gegründet?", answers: [{ text: "1896 in der Schweiz", correct: true }, { text: "1925 in Deutschland", correct: false }, { text: "2001 in den USA", correct: false }, { text: "1880 in Frankreich", correct: false }] },
  { question: "Welche beiden Bereiche bilden das Roche-Geschäft?", answers: [{ text: "Diagnostik und Pharma", correct: true }, { text: "Tourismus und Logistik", correct: false }, { text: "Software und Bauwesen", correct: false }, { text: "Ernährung und Sport", correct: false }] },
  { question: "Was möchte Roche für Patientinnen und Patienten erreichen?", answers: [{ text: "Krankheiten verhindern, stoppen und heilen", correct: true }, { text: "Nur bestehende Produkte verkaufen", correct: false }, { text: "Gesundheitsdaten sammeln, ohne sie auszuwerten", correct: false }, { text: "Ausschließlich Krankenhäuser bauen", correct: false }] },
  { question: "In welchen Bereichen forscht Roche unter anderem?", answers: [{ text: "Onkologie, Neurologie sowie Herz-Kreislauf- und Stoffwechselerkrankungen", correct: true }, { text: "Nur in der Raumfahrt", correct: false }, { text: "Ausschließlich in der Landwirtschaft", correct: false }, { text: "Nur in der Unterhaltungselektronik", correct: false }] },
  { question: "Warum sind Diagnostik und Früherkennung wichtig?", answers: [{ text: "Erkrankungen können früher verstanden und passende Behandlungen schneller gefunden werden", correct: true }, { text: "Damit Medikamente nicht geprüft werden müssen", correct: false }, { text: "Damit Forschung überflüssig wird", correct: false }, { text: "Nur um Papier zu sparen", correct: false }] },
  { question: "Was bedeutet der kombinierte Ansatz von Roche?", answers: [{ text: "Diagnostik, digitale Lösungen und Medikamente gemeinsam an den Bedürfnissen von Patientinnen und Patienten auszurichten", correct: true }, { text: "Nur Medikamente ohne Tests zu entwickeln", correct: false }, { text: "Alle Produkte identisch zu machen", correct: false }, { text: "Forschung durch Werbung zu ersetzen", correct: false }] },
  { question: "Was unterstützt laut Roche den langfristigen Erfolg?", answers: [{ text: "Innovation, gute Abläufe, engagierte Mitarbeitende und Nachhaltigkeit", correct: true }, { text: "Stillstand und möglichst wenige Ideen", correct: false }, { text: "Arbeiten ohne Qualitätsstandards", correct: false }, { text: "Nur schnelle Entscheidungen ohne Prüfung", correct: false }] },
];

// Mischt eine Liste, ohne das ursprüngliche Array zu verändern.
function shuffle<T>(items: T[]) {
  return [...items].sort(() => Math.random() - 0.5);
}

// Setzt die Gründungsfrage an die erste Stelle und mischt den Rest.
function createQuiz() {
  const foundingQuestion = sourceQuestions[0];
  const remainingQuestions = shuffle(sourceQuestions.slice(1));

  return [foundingQuestion, ...remainingQuestions].map((question) => ({
    ...question,
    answers: shuffle(question.answers),
  }));
}

// Liest bereits verwendete Namen aus localStorage; beim ersten Laden gibt es eine leere Liste.
function getStoredNames(): string[] {
  if (typeof window === "undefined") return [];
  const savedNames = window.localStorage.getItem(USED_NAMES_KEY);
  if (!savedNames) return [];

  try {
    const names = JSON.parse(savedNames);
    return Array.isArray(names) ? names.filter((name): name is string => typeof name === "string") : [];
  } catch {
    window.localStorage.removeItem(USED_NAMES_KEY);
    return [];
  }
}

function readResults(): QuizResult[] {
  if (typeof window === "undefined") return [];
  try {
    const savedResults = window.localStorage.getItem(RESULTS_KEY);
    const parsed = savedResults ? JSON.parse(savedResults) : [];
    return Array.isArray(parsed) ? parsed.filter((result): result is QuizResult => result && typeof result.name === "string" && typeof result.correct === "number") : [];
  } catch {
    return [];
  }
}

function normalizeName(value: string): string {
  return value.trim().toLocaleLowerCase("de-DE");
}

function sortResults(results: QuizResult[]): QuizResult[] {
  return [...results].sort((first, second) => second.correct - first.correct || new Date(first.completedAt).getTime() - new Date(second.completedAt).getTime());
}

function rankResults(results: QuizResult[]): QuizResult[] {
  return sortResults(results).map((result, index) => ({ ...result, rank: index + 1 }));
}

export default function Home() {
  // React-Zustände speichern Eingaben, Fortschritt, Antworten und Darstellung.
  const [name, setName] = useState("");
  const [nameError, setNameError] = useState("");
  const [resetMessage, setResetMessage] = useState("");
  const [usedNames, setUsedNames] = useState<string[]>(getStoredNames);
  const [started, setStarted] = useState(false);
  const [finished, setFinished] = useState(false);
  const [current, setCurrent] = useState(0);
  const [answersByQuestion, setAnswersByQuestion] = useState<Array<boolean | null>>(() => Array(sourceQuestions.length).fill(null));
  const [questions, setQuestions] = useState<Question[]>(createQuiz);
  const [darkMode, setDarkMode] = useState(false);
  const [results, setResults] = useState<QuizResult[]>(() => rankResults(readResults()));
  const [savedResult, setSavedResult] = useState<QuizResult | null>(null);
  const [showRanking, setShowRanking] = useState(false);

  // Der Testname macht im Quiz die richtige Antwort fett sichtbar.
  const isDevMode = name.trim() === "1234567899";
  const question = questions[current];
  const score = answersByQuestion.filter(Boolean).length;
  const showFoundingVideo = question.question === "Wann und wo wurde Roche gegründet?";
  const progress = finished ? 100 : (current / questions.length) * 100;
  const ranking = useMemo(() => rankResults(results), [results]);

  useEffect(() => {
    if (!finished || savedResult || !name.trim()) return;

    const saveTimer = window.setTimeout(() => {
      const result: QuizResult = {
        id: `${Date.now()}-${name.trim()}`,
        name: name.trim(),
        correct: score,
        total: questions.length,
        percentage: Math.round((score / questions.length) * 100),
        completedAt: new Date().toISOString(),
        rank: 0,
      };
      const nextResults = rankResults([...results.filter((item) => normalizeName(item.name) !== normalizeName(result.name)), result]);
      const currentResult = nextResults.find((item) => item.id === result.id) ?? result;

      try {
        window.localStorage.setItem(RESULTS_KEY, JSON.stringify(nextResults));
      } catch {
        // Das Quiz funktioniert auch, wenn der Browser keinen Speicher erlaubt.
      }
      setResults(nextResults);
      setSavedResult(currentResult);
    }, 0);

    return () => window.clearTimeout(saveTimer);
  }, [finished, name, questions.length, results, savedResult, score]);

  // Löscht die lokal gespeicherten Namen und zeigt eine Erfolgsmeldung.
  function resetStoredNames() {
    window.localStorage.removeItem(USED_NAMES_KEY);
    window.localStorage.removeItem(RESULTS_KEY);
    setUsedNames([]);
    setResults([]);
    setSavedResult(null);
    setShowRanking(false);
    setNameError("");
    setResetMessage("Die gespeicherten Daten wurden erfolgreich gelöscht.");
  }

  // Prüft den Namen, speichert ihn einmalig und startet einen neuen Quizdurchlauf.
  function startQuiz(event: FormEvent<HTMLFormElement>) {
    event.preventDefault();
    const cleanName = name.trim();
    const normalizedName = cleanName.toLowerCase();

    if (!cleanName) {
      setNameError("Bitte gib deinen Namen ein.");
      return;
    }
    if (cleanName.length > 25) {
      setNameError("Der Name darf höchstens 25 Zeichen lang sein.");
      return;
    }
    if (usedNames.includes(normalizedName) || results.some((result) => normalizeName(result.name) === normalizedName)) {
      setNameError("Dieser Name wurde bereits verwendet. Bitte wähle einen anderen Namen.");
      return;
    }

    const updatedNames = [...usedNames, normalizedName];
    setUsedNames(updatedNames);
    window.localStorage.setItem(USED_NAMES_KEY, JSON.stringify(updatedNames));
    setNameError("");
    setResetMessage("");
    setQuestions(createQuiz());
    setCurrent(0);
    setAnswersByQuestion(Array(sourceQuestions.length).fill(null));
    setFinished(false);
    setSavedResult(null);
    setShowRanking(false);
    setStarted(true);
  }

  // Speichert die Lösung und springt sofort zur nächsten Frage.
  function chooseAnswer(answerIndex: number) {
    setAnswersByQuestion((previousAnswers) => {
      const updatedAnswers = [...previousAnswers];
      updatedAnswers[current] = question.answers[answerIndex].correct;
      return updatedAnswers;
    });

    if (current === questions.length - 1) {
      setFinished(true);
      return;
    }

    setCurrent((value) => value + 1);
  }

  // Setzt das Quiz für einen neuen Durchlauf zurück.
  function restart() {
    setStarted(false);
    setFinished(false);
    setName("");
    setNameError("");
    setCurrent(0);
    setAnswersByQuestion(Array(sourceQuestions.length).fill(null));
    setQuestions(createQuiz());
    setSavedResult(null);
    setShowRanking(false);
  }

  // Gemeinsame Tailwind-Klassen für Hellmodus, Night Mode und Antwortfarben.
  const pageBackground = darkMode ? "bg-[#101820] text-slate-100" : "bg-[#f4f7fa] text-[#172b4d]";
  const cardBackground = darkMode ? "border-slate-700 bg-slate-900/90" : "border-white bg-white/90";
  const mutedText = darkMode ? "text-slate-300" : "text-slate-600";
  const answerColors = darkMode
    ? ["border-blue-500/50 bg-blue-500/10 hover:bg-blue-500/20", "border-red-400/50 bg-red-400/10 hover:bg-red-400/20", "border-yellow-400/50 bg-yellow-400/10 hover:bg-yellow-400/20", "border-emerald-400/50 bg-emerald-400/10 hover:bg-emerald-400/20"]
    : ["border-blue-200 bg-blue-50 hover:bg-blue-100", "border-red-200 bg-red-50 hover:bg-red-100", "border-yellow-200 bg-yellow-50 hover:bg-yellow-100", "border-emerald-200 bg-emerald-50 hover:bg-emerald-100"];
  const answerLetters = ["A", "B", "C", "D"];

  // Die Oberfläche wechselt je nach Zustand zwischen Start, Quiz und Ergebnis.
  return (
    <main className={`relative min-h-screen overflow-hidden transition-colors duration-300 ${pageBackground}`}>
      {/* Dekorative Formen liegen hinter dem Inhalt und blockieren keine Klicks. */}
      <div className="absolute inset-0 pointer-events-none opacity-70" aria-hidden="true">
        <div className="absolute -left-24 top-36 h-64 w-64 rounded-full border-[42px] border-red-500/70 [clip-path:inset(0_0_50%_0)] -rotate-12" />
        <div className="absolute -right-20 bottom-24 h-72 w-72 rounded-full border-[46px] border-yellow-400/70 [clip-path:inset(50%_0_0_0)] rotate-12" />
        <div className="absolute right-[12%] top-24 h-28 w-28 rotate-12 rounded-[42%_58%_65%_35%] border-[20px] border-blue-500/30" />
        <div className="absolute bottom-24 left-[14%] h-20 w-20 -rotate-12 rounded-[65%_35%_45%_55%] bg-pink-400/25" />
      </div>

      {/* Kopfzeile mit Logo, Bereichsbezeichnung und Quizstatus. */}
      <header className={`relative z-10 flex w-full items-center justify-between px-5 py-3 shadow-sm transition-colors lg:px-10 ${darkMode ? "bg-[#101820]" : "bg-white"}`}>
        <div className="flex items-center gap-4">
          <Image src="/roche-logo.png" alt="Roche" width={150} height={60} priority unoptimized className="h-9 w-28 object-contain" />
          <span className={`hidden border-l pl-3 text-[10px] font-semibold tracking-[0.16em] sm:block ${mutedText}`}>DIAGNOSTICS &amp; PHARMA</span>
        </div>
        <div className="flex items-center gap-3">
          <button type="button" onClick={() => setShowRanking((value) => !value)} aria-pressed={showRanking} className={`rounded-lg border px-3 py-2 text-xs font-semibold transition hover:border-blue-700 hover:text-blue-700 ${darkMode ? "border-slate-600 text-slate-200" : "border-slate-200 text-slate-700"}`}>Rangliste</button>
          <div className={`hidden text-xs font-semibold uppercase tracking-[0.18em] sm:block ${mutedText}`}>Wissenstest <span className="ml-2 inline-block h-2 w-2 rounded-full bg-emerald-500" /></div>
        </div>
      </header>

      {/* Hauptbereich: zeigt Startformular, Fragen oder Ergebnis. */}
      <section className="relative z-10 mx-auto flex min-h-[calc(100vh-104px)] w-full max-w-6xl items-center justify-center px-6 pb-12 lg:px-10">
        {/* Noch nicht gestartet: Name eingeben und Quiz beginnen. */}
        {showRanking ? (
          <section className={`w-full max-w-3xl rounded-[2rem] border p-8 shadow-2xl backdrop-blur-xl md:p-12 ${cardBackground}`}>
            <div className="flex flex-wrap items-start justify-between gap-4">
              <div>
                <p className="text-xs font-bold uppercase tracking-[0.25em] text-blue-700">Roche Wissenstest</p>
                <h1 className="mt-3 text-4xl font-bold tracking-tight md:text-5xl">Rangliste</h1>
              </div>
              <span className={`rounded-full px-3 py-2 text-xs font-semibold ${darkMode ? "bg-slate-800 text-slate-300" : "bg-slate-100 text-slate-600"}`}>Lokal gespeichert</span>
            </div>
            {ranking.length === 0 ? (
              <p className={`mt-10 rounded-xl border border-dashed p-8 text-center ${mutedText}`}>Noch keine Ergebnisse vorhanden. Starte den Wissenstest und sichere dir den ersten Platz.</p>
            ) : (
              <ol className="mt-8 space-y-3" aria-label="Rangliste">
                {ranking.map((result) => (
                  <li key={result.id} className={`flex items-center gap-3 rounded-xl border px-4 py-3 ${savedResult?.id === result.id ? "border-blue-600 ring-2 ring-blue-200" : darkMode ? "border-slate-700 bg-slate-800/70" : "border-slate-200 bg-slate-50"}`}>
                    <span className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-bold ${result.rank === 1 ? "bg-yellow-300 text-yellow-950" : result.rank === 2 ? "bg-slate-300 text-slate-800" : result.rank === 3 ? "bg-orange-300 text-orange-950" : darkMode ? "bg-slate-700 text-slate-200" : "bg-white text-slate-600"}`}>{result.rank}</span>
                    <span className="min-w-0 flex-1 truncate font-semibold">{result.name}{savedResult?.id === result.id && <span className="ml-2 text-xs font-normal text-blue-700">(dein Ergebnis)</span>}</span>
                    <span className="text-right text-sm font-semibold"><strong>{result.correct}/{result.total}</strong><span className={`ml-2 hidden text-xs font-normal sm:inline ${mutedText}`}>{result.percentage}%</span></span>
                  </li>
                ))}
              </ol>
            )}
            <button type="button" onClick={() => setShowRanking(false)} className="mt-8 rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white transition hover:bg-blue-800">Zurück zum Wissenstest <span aria-hidden="true">→</span></button>
          </section>
        ) : !started ? (
          <div className={`grid w-full max-w-5xl gap-10 rounded-[2rem] border p-8 shadow-2xl backdrop-blur-xl md:grid-cols-[1.15fr_0.85fr] md:p-14 ${cardBackground}`}>
            <div className="flex flex-col justify-center">
              <p className="mb-4 text-xs font-bold uppercase tracking-[0.25em] text-blue-700">Roche Wissenstest</p>
              <h1 className="max-w-xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">Doing now what patients <span className="font-serif text-blue-700 italic tracking-tight">need next.</span></h1>
              <p className={`mt-6 max-w-lg text-lg leading-8 ${mutedText}`}>Wie gut kennst du Roche? Entdecke die Geschichte, Forschung und Ideen hinter einem weltweit tätigen Gesundheitsunternehmen.</p>
              <div className={`mt-8 flex gap-3 text-sm font-semibold ${mutedText}`}><span>07 Fragen</span><span>·</span><span>ca. 1 Minute</span></div>
            </div>
            <form className={`flex flex-col justify-center rounded-3xl p-6 ${darkMode ? "bg-slate-800" : "bg-slate-50"}`} onSubmit={startQuiz}>
              <label htmlFor="name" className="font-semibold">Wie heißt du?</label>
              <input id="name" type="text" value={name} onChange={(event) => { setName(event.target.value); setNameError(""); setResetMessage(""); }} placeholder="Dein Vorname" maxLength={25} autoComplete="given-name" required className={`mt-3 rounded-xl border px-4 py-3 outline-none ring-blue-200 transition focus:ring-4 ${darkMode ? "border-slate-600 bg-slate-700 text-white placeholder:text-slate-400" : "border-slate-200 bg-white text-slate-900"}`} />
              {nameError && <p className="mt-2 text-sm font-medium text-red-600">{nameError}</p>}
              {resetMessage && <p className="mt-2 text-sm font-medium text-emerald-600">{resetMessage}</p>}
              <button className="mt-5 rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue-800" type="submit">Test starten <span aria-hidden="true">→</span></button>
              <small className={`mt-3 text-center ${mutedText}`}>Keine Anmeldung nötig.</small>
              <button type="button" onClick={resetStoredNames} className={`mt-2 text-xs underline transition hover:text-blue-700 ${mutedText}`}>Gespeicherte Daten zurücksetzen</button>
            </form>
          </div>
        ) : finished ? (
          <div className={`w-full max-w-2xl rounded-[2rem] border p-8 text-center shadow-2xl backdrop-blur-xl md:p-14 ${cardBackground}`}>
            {/* Zeigt das Ergebnis und bietet einen Neustart an. */}
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-blue-700">Wissenstest abgeschlossen</p>
            <div className="my-8"><strong className="text-7xl font-bold text-blue-700">{score}<small className={`text-3xl ${mutedText}`}> / {questions.length}</small></strong><span className={`mt-2 block ${mutedText}`}>richtige Antworten</span></div>
            <h1 className="text-3xl font-bold">Danke, {name.trim()}!</h1>
            <p className={`mt-3 ${mutedText}`}>Du hast {score} von {questions.length} Roche-Fragen richtig beantwortet.</p>
            {savedResult && <p className="mt-4 text-lg font-semibold text-blue-700">Dein Rang: {savedResult.rank}. Platz</p>}
            <div className="my-8 flex justify-center gap-2" aria-label={`${score} von ${questions.length} Fragen richtig`}>{questions.map((item, index) => <span key={item.question} className={`h-3 w-8 rounded-full ${index < score ? "bg-blue-700" : darkMode ? "bg-slate-700" : "bg-slate-200"}`} />)}</div>
            <div className="flex flex-wrap justify-center gap-3">
              <button className="rounded-xl bg-blue-700 px-6 py-3 font-semibold text-white transition hover:bg-blue-800" onClick={restart}>Nochmal starten <span>↻</span></button>
              <button type="button" onClick={() => setShowRanking(true)} className={`rounded-xl border px-6 py-3 font-semibold transition hover:border-blue-700 hover:text-blue-700 ${darkMode ? "border-slate-600" : "border-slate-200"}`}>Rangliste ansehen</button>
            </div>
          </div>
        ) : (
          <div className={`w-full max-w-4xl rounded-[2rem] border p-8 shadow-2xl backdrop-blur-xl md:p-14 ${cardBackground}`}>
            {/* Während des Quiz: Fortschritt, Video, Frage und Antworten anzeigen. */}
            <div className="flex items-start justify-between gap-4"><div><p className="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">Roche Wissenstest · {name.trim()}</p><h1 className="mt-3 text-3xl font-bold md:text-5xl">Deine nächste Frage</h1></div><div className="text-right"><strong className="text-4xl text-blue-700">{String(current + 1).padStart(2, "0")}</strong><span className={`block text-sm ${mutedText}`}>/ {String(questions.length).padStart(2, "0")}</span></div></div>
            <div className={`mt-8 h-2 overflow-hidden rounded-full ${darkMode ? "bg-slate-700" : "bg-slate-100"}`}><span className="block h-full rounded-full bg-blue-700 transition-all duration-300" style={{ width: `${progress}%` }} /></div>
            <p className="mt-10 text-2xl font-semibold leading-relaxed md:text-3xl">{question.question}</p>
            {showFoundingVideo && (
              <div className="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-black shadow-lg">
                <video className="aspect-video w-full" controls preload="metadata" title="Screenrecording zur Gründung von Roche">
                  <source src="/Bildschirmaufnahme%202026-10-13%20104014.mp4" type="video/mp4" />
                  Dein Browser unterstützt dieses Videoformat nicht.
                </video>
              </div>
            )}
            <div className="mt-8 grid gap-4 md:grid-cols-2" role="group" aria-label="Antwortmöglichkeiten">{question.answers.map((answer, index) => <button key={answer.text} className={`flex min-h-20 items-center gap-4 rounded-2xl border-2 px-5 py-4 text-left font-medium transition hover:-translate-y-0.5 ${answerColors[index]} ${isDevMode && answer.correct ? "font-extrabold" : ""}`} onClick={() => chooseAnswer(index)}><span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/80 text-sm font-bold text-slate-700">{answerLetters[index]}</span><span>{answer.text}</span></button>)}</div>
            <div className={`mt-8 flex flex-col gap-4 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between ${darkMode ? "border-slate-700 text-slate-300" : "border-slate-200 text-slate-600"}`}>
              <span>Wähle eine Antwort aus, um automatisch weiterzugehen.</span>
              {current > 0 && <button type="button" onClick={() => setCurrent((value) => value - 1)} className="font-semibold text-blue-700 transition hover:text-blue-900">← Zurück</button>}
            </div>
          </div>
        )}
      </section>

      {/* Fußzeile mit Projektname, Slogan und Night-Mode-Umschalter. */}
      <footer className={`relative z-10 mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-6 pb-6 text-xs ${mutedText} lg:px-10`}><span>Roche Wissenstest</span><span>Doing now what patients need next.</span><div className="flex items-center gap-4"><button type="button" onClick={() => setShowRanking((value) => !value)} className="font-semibold transition hover:text-blue-700">Rangliste</button><button type="button" onClick={() => setDarkMode((value) => !value)} className="font-semibold transition hover:text-blue-700" aria-label={darkMode ? "Light mode aktivieren" : "Dark mode aktivieren"}>{darkMode ? "☀ Light mode" : "☾ Night mode"}</button></div></footer>
    </main>
  );
}
