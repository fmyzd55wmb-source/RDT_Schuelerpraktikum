            {showAdmin && user.role === "admin" && <div className={`admin-panel mt-5 rounded-xl border p-4 text-left ${darkMode ? "dark-admin-panel border-slate-700 bg-slate-900/95 text-slate-100" : "border-slate-200 bg-white"}`}><div className="flex flex-wrap items-center justify-between gap-3"><p className="text-sm font-semibold">Adminbereich</p><div className="flex flex-wrap gap-2"><button type="button" onClick={() => { setEditingQuizId(null); setNewQuizTitle(""); setNewQuizDescription(""); setDraftQuestions([emptyDraftQuestion()]); setShowQuizCreator(true); setQuizCreateError(""); }} className="rounded-lg bg-blue-700 px-3 py-2 text-xs font-semibold text-white">Neues Quiz erstellen</button><button type="button" onClick={() => { setShowAdmin(false); setShowQuizCreator(false); setEditingQuizId(null); }} className={`rounded-lg border px-3 py-2 text-xs font-semibold ${darkMode ? "border-slate-600 text-slate-200" : "border-slate-300 text-slate-700"}`}>Adminbereich schließen</button></div></div><div className={`admin-subpanel mt-4 rounded-lg p-3 ${darkMode ? "dark-admin-subpanel bg-slate-800" : "bg-slate-50"}`}><p className="mb-2 text-xs font-semibold">Quizverwaltung</p><div className={`scroll-area max-h-72 overflow-y-auto overscroll-contain pr-1 ${darkMode ? "dark-scroll-area" : ""}`}>{availableQuizzes.map((quiz) => <div key={quiz.id} className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-200 py-2 text-xs last:border-0"><span className="min-w-0 flex-1 truncate font-semibold">{quiz.title}{quiz.isSystem && <span className="ml-2 text-[10px] font-normal uppercase text-slate-500">System</span>}</span><span className="text-slate-500">{quiz.questions.length} Fragen</span><button type="button" onClick={() => editQuiz(quiz)} className="font-semibold text-blue-700 underline">Bearbeiten</button><button type="button" onClick={() => void deleteCustomQuiz(quiz.id)} className="font-semibold text-red-600 underline">Löschen</button></div>)}</div></div><div className={`scroll-area mt-4 max-h-56 overflow-auto ${darkMode ? "dark-scroll-area" : ""}`}><p className="mb-2 text-xs font-semibold">Benutzer</p>{adminUsers.map((adminUser) => <div key={adminUser.id} className="flex items-center justify-between gap-2 border-b border-slate-100 py-2 text-xs last:border-0"><span className="min-w-0 truncate">{adminUser.username} {adminUser.role === "admin" && "(Admin)"}</span><button type="button" onClick={() => void deleteAdminUser(adminUser.id)} className="text-red-600 underline">{adminUser.id === user.id ? "Admin löschen" : "Löschen"}</button></div>)}</div>{showQuizCreator && <form onSubmit={saveNewQuiz} className="mt-5 border-t border-slate-200 pt-5"><h3 className="text-lg font-bold">{editingQuizId ? "Quiz bearbeiten" : "Neues Quiz erstellen"}</h3><div className="mt-3 grid gap-3 md:grid-cols-2"><input value={newQuizTitle} onChange={(event) => setNewQuizTitle(event.target.value)} maxLength={100} placeholder="Titel" required className="rounded-lg border border-slate-200 px-3 py-2" /><input value={newQuizDescription} onChange={(event) => setNewQuizDescription(event.target.value)} maxLength={300} placeholder="Beschreibung" required className="rounded-lg border border-slate-200 px-3 py-2" /></div><div className="mt-4 space-y-4">{draftQuestions.map((draft, questionIndex) => <fieldset key={questionIndex} className="rounded-xl border border-slate-200 p-4"><legend className="px-1 text-sm font-semibold">Frage {questionIndex + 1}</legend><div className="grid gap-3 md:grid-cols-[1fr_180px]"><input value={draft.question} onChange={(event) => updateDraftQuestion(questionIndex, { question: event.target.value })} placeholder="Fragetext" required className="rounded-lg border border-slate-200 px-3 py-2" /><select value={draft.kind} onChange={(event) => updateDraftQuestion(questionIndex, { kind: event.target.value as QuestionKind })} className="rounded-lg border border-slate-200 px-3 py-2"><option value="multiple-choice">Multiple Choice</option><option value="text">Lückentext</option><option value="number">Zahleneingabe</option><option value="true-false">Wahr/Falsch</option></select></div>{draft.kind === "multiple-choice" && <div className="mt-3 grid gap-2 sm:grid-cols-2">{draft.answers.map((answer, answerIndex) => <label key={answerIndex} className="flex items-center gap-2 text-sm"><input type="radio" name={`correct-${questionIndex}`} checked={draft.correctIndex === answerIndex} onChange={() => updateDraftQuestion(questionIndex, { correctIndex: answerIndex })} /><input value={answer} onChange={(event) => updateDraftAnswer(questionIndex, answerIndex, event.target.value)} placeholder={`Antwort ${answerIndex + 1}`} required className="min-w-0 flex-1 rounded-lg border border-slate-200 px-3 py-2" /></label>)}</div>}{draft.kind === "text" && <input value={draft.expectedAnswer} onChange={(event) => updateDraftQuestion(questionIndex, { expectedAnswer: event.target.value })} placeholder="Erwartete Antwort" required className="mt-3 w-full rounded-lg border border-slate-200 px-3 py-2" />}{draft.kind === "true-false" && <select value={String(draft.expectedBoolean)} onChange={(event) => updateDraftQuestion(questionIndex, { expectedBoolean: event.target.value === "true" })} className="mt-3 rounded-lg border border-slate-200 px-3 py-2"><option value="true">Richtig: Wahr</option><option value="false">Richtig: Falsch</option></select>}{draft.kind === "number" && <div className="mt-3 grid gap-2 sm:grid-cols-2"><input type="number" value={draft.expectedNumber} onChange={(event) => updateDraftQuestion(questionIndex, { expectedNumber: event.target.value })} placeholder="Erwartete Zahl" required className="rounded-lg border border-slate-200 px-3 py-2" /><input value={draft.unit} onChange={(event) => updateDraftQuestion(questionIndex, { unit: event.target.value })} placeholder="Einheit, z. B. Tage" required className="rounded-lg border border-slate-200 px-3 py-2" /></div>}<button type="button" onClick={() => setDraftQuestions((previous) => previous.filter((_, index) => index !== questionIndex))} className="mt-3 ml-2 inline-block text-xs font-semibold text-red-600 underline" disabled={draftQuestions.length === 1}>Frage entfernen</button></fieldset>)}</div><div className="mt-4 flex flex-wrap gap-3"><button type="button" onClick={() => setDraftQuestions((previous) => [...previous, emptyDraftQuestion()])} className="rounded-lg border border-blue-700 px-3 py-2 text-sm font-semibold text-blue-700">Frage hinzufügen</button><button type="submit" disabled={quizCreating} className="rounded-lg bg-blue-700 px-4 py-2 text-sm font-semibold text-white disabled:opacity-60">{quizCreating ? "Speichert …" : "Quiz speichern"}</button><button type="button" onClick={() => { setShowQuizCreator(false); setEditingQuizId(null); setQuizCreateError(""); }} className="rounded-lg border border-slate-200 px-3 py-2 text-sm">Abbrechen</button></div>{quizCreateError && <p className="mt-3 text-sm font-medium text-red-600">{quizCreateError}</p>}</form>}</div>}
