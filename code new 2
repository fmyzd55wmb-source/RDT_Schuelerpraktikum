"use client";

import Image from "next/image";
import { useEffect, useRef, useState, type FormEvent } from "react";

type QuizId = string;
type QuestionKind = "multiple-choice" | "text" | "number" | "true-false";
type Answer = { text: string; correct: boolean };
type MultipleChoiceQuestion = { id: string; kind: Extract<QuestionKind, "multiple-choice">; question: string; answers: Answer[] };
type TextQuestion = { id: string; kind: Extract<QuestionKind, "text">; question: string; placeholder: string; expectedAnswers: string[]; feedbackAnswer: string };
type NumberQuestion = { id: string; kind: Extract<QuestionKind, "number">; question: string; placeholder: string; expectedNumber: number; unit: string; feedbackAnswer: string };
type TrueFalseQuestion = { id: string; kind: Extract<QuestionKind, "true-false">; question: string; expectedBoolean: boolean };
type Question = MultipleChoiceQuestion | TextQuestion | NumberQuestion | TrueFalseQuestion;
type QuizDefinition = { id: QuizId; title: string; description: string; questions: Question[]; isSystem?: boolean; questionCount?: number };
type User = { id: number; username: string; role: "user" | "admin" };
type AdminUser = { id: number; username: string; role: "user" | "admin"; bestCorrect: number | null; bestTotal: number | null; bestElapsedMs: number | null; bestCompletedAt: string | null; attempts: number };
type QuizResult = { id: number; username: string; quizId: QuizId; correct: number; total: number; elapsedMs: number; percentage: number; completedAt: string; attempts?: number; attemptNumber?: number; rank?: number | null };
type DraftQuestion = { kind: QuestionKind; question: string; answers: string[]; correctIndex: number; expectedAnswer: string; expectedNumber: string; unit: string; expectedBoolean: boolean };
type Feedback = { correct: boolean; expected: string };

