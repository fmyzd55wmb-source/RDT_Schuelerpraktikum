ext-slate-600"}`} aria-label={showPassword ? "Passwort verbergen" : "Passwort anzeigen"}>{showPassword ? "Verbergen" : "Anzeigen"}</button></div>{authMode === "register" && <small className={`mt-2 ${mutedText}`}>Mindestens 12 Zeichen, Zahl, Groß-/Kleinbuchstabe und Sonderzeichen.</small>}{authError && <p className="mt-3 text-sm font-medium text-red-600">{authError}</p>}<button className="mt-5 rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-blue-800 disabled:cursor-wait disabled:opacity-60" type="submit" disabled={loading}>{loading ? "Bitte warten …" : authMode === "login" ? "Anmelden" : "Registrieren"} <span aria-hidden="true">→</span></button></form>
