            <div className="flex items-start justify-between gap-4"><div><p className="text-xs font-bold uppercase tracking-[0.2em] text-blue-700">{activeQuiz.title} · {name.trim()}</p><h1 className="mt-3 text-3xl font-bold md:text-5xl">Deine nächste Frage</h1></div><div className="text-right"><strong className="text-4xl text-blue-700">{String(current + 1).padStart(2, "0")}</strong><span className={`block text-sm ${mutedText}`}>/ {String(questions.length).padStart(2, "0")}</span><span className={`mt-2 block text-sm font-semibold ${mutedText}`} aria-label="Vergangene Zeit">Zeit {formatElapsed(elapsedMs)}</span></div></div>
            <div className={`mt-8 h-2 overflow-hidden rounded-full ${darkMode ? "bg-slate-700" : "bg-slate-100"}`}><span className="block h-full rounded-full bg-blue-700 transition-all duration-300" style={{ width: `${progress}%` }} /></div>
            {question && <><p className="mt-10 text-2xl font-semibold leading-relaxed md:text-3xl">{question.question}</p>{showFoundingVideo && <div className="mt-6 overflow-hidden rounded-2xl border border-slate-200 bg-black shadow-lg"><video className="aspect-video w-full" controls preload="metadata" title="Screenrecording zur Gründung von Roche"><source src="/Bildschirmaufnahme%202026-10-13%20104014.mp4" type="video/mp4" />Dein Browser unterstützt dieses Videoformat nicht.</video></div>}
              {question.kind === "multiple-choice" ? <div className="mt-8 grid gap-4 md:grid-cols-2" role="group" aria-label="Antwortmöglichkeiten">{question.answers.map((answer, index) => <button key={answer.text} type="button" disabled={Boolean(feedback)} className={`flex min-h-20 items-center gap-4 rounded-2xl border-2 px-5 py-4 text-left font-medium transition hover:-translate-y-0.5 disabled:cursor-default disabled:hover:translate-y-0 ${answerColors[index]} ${isDevMode && answer.correct ? "font-extrabold" : ""}`} onClick={() => chooseAnswer(answer)}><span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/80 text-sm font-bold text-slate-700">{answerLetters[index]}</span><span>{answer.text}</span></button>)}</div> : question.kind === "true-false" ? <div className="mt-8 grid gap-4 sm:grid-cols-2" role="group" aria-label="Wahr oder Falsch"><button type="button" disabled={Boolean(feedback)} onClick={() => chooseBooleanAnswer(true)} className="min-h-20 rounded-2xl border-2 border-emerald-200 bg-emerald-50 px-5 py-4 text-lg font-semibold text-emerald-900 disabled:opacity-60">Wahr</button><button type="button" disabled={Boolean(feedback)} onClick={() => chooseBooleanAnswer(false)} className="min-h-20 rounded-2xl border-2 border-red-200 bg-red-50 px-5 py-4 text-lg font-semibold text-red-900 disabled:opacity-60">Falsch</button></div> : <form onSubmit={submitFreeAnswer} className="mt-8 flex max-w-xl flex-col gap-3 sm:flex-row"><input type={question.kind === "number" ? "number" : "text"} inputMode={question.kind === "number" ? "numeric" : "text"} value={answerDraft} onChange={(event) => { setAnswerDraft(event.target.value); setAnswerError(""); }} placeholder={question.placeholder} disabled={Boolean(feedback)} className={`min-w-0 flex-1 rounded-xl border px-4 py-3 outline-none ring-blue-200 focus:ring-4 ${darkMode ? "border-slate-600 bg-slate-700 text-white" : "border-slate-200 bg-white text-slate-900"}`} aria-label="Antwort eingeben" /><button type="submit" disabled={Boolean(feedback)} className="rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white disabled:opacity-60">Prüfen</button></form>}
              {answerError && <p className="mt-3 text-sm font-medium text-red-600">{answerError}</p>}
              {feedback && <div className={`mt-8 rounded-2xl border p-5 ${feedback.correct ? "border-emerald-300 bg-emerald-50 text-emerald-900" : "border-red-300 bg-red-50 text-red-900"}`} role="status"><p className="font-bold">{feedback.correct ? "Richtig!" : "Noch nicht richtig."}</p>{!feedback.correct && <p className="mt-1 text-sm">Richtige Antwort: {feedback.expected}</p>}<button type="button" onClick={continueQuiz} className="mt-4 rounded-xl bg-blue-700 px-5 py-3 font-semibold text-white">{current === questions.length - 1 ? "Ergebnis anzeigen" : "Weiter"} <span aria-hidden="true">→</span></button></div>}
              <div className={`mt-8 flex flex-col gap-4 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between ${darkMode ? "border-slate-700 text-slate-300" : "border-slate-200 text-slate-600"}`}><span>{feedback ? "Prüfe dein Feedback und fahre dann fort." : question.kind === "multiple-choice" ? "Wähle eine Antwort aus." : question.kind === "true-false" ? "Wähle Wahr oder Falsch aus." : "Gib deine Antwort ein und prüfe sie."}</span><button type="button" onClick={backToDashboard} className="font-semibold text-blue-700 transition hover:text-blue-900">← Dashboard</button></div>
            </>}
          </div>
        )}
      </section>

      <footer className={`relative z-10 mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-6 pb-6 text-xs ${mutedText} lg:px-10`}><span>Roche Wissenstest</span><span>Doing now what patients need next.</span><div className="flex items-center gap-4"><button type="button" onClick={() => setDarkMode((value) => !value)} className="font-semibold transition hover:text-blue-700" aria-label={darkMode ? "Light mode aktivieren" : "Dark mode aktivieren"}>{darkMode ? "☀ Light mode" : "☾ Night mode"}</button></div></footer>
    </main>
  );
}
