                    <span className={`flex h-9 w-9 shrink-0 items-center justify-center rounded-full font-bold ${result.rank === 1 ? "bg-[#BABABA] text-[#000000]" : result.rank === 2 ? "bg-[#BABABA] text-[#000000]" : result.rank === 3 ? "bg-[#4C5456] text-[#FFFFFF]" : darkMode ? "bg-[#4C5456] text-[#FFFFFF]" : "bg-white text-[#4C5456]"}`}>{result.rank}</span>
                    <span className="min-w-0 flex-1 truncate font-semibold">{result.name}{savedResult?.id === result.id && <span className="ml-2 text-xs font-normal text-[#0B41CD]">(dein Ergebnis)</span>}</span>
                    <span className="text-right text-sm font-semibold"><strong>{result.correct}/{result.total}</strong><span className={`ml-2 hidden text-xs font-normal sm:inline ${mutedText}`}>{result.percentage}% · {formatDuration(result.durationMs)} · {result.attempts} {result.attempts === 1 ? "Versuch" : "Versuche"}</span></span>
                  </li>
                ))}
              </ol>
            )}
            <button type="button" onClick={() => setShowRanking(false)} className="mt-8 rounded-xl bg-[#0B41CD] px-5 py-3 font-semibold text-white transition hover:bg-[#0B41CD]">Zurück zum Wissenstest <span aria-hidden="true">→</span></button>
          </section>
        ) : !started ? (
          <div className={`grid w-full max-w-5xl gap-10 rounded-[2rem] border border-t-4 border-t-blue-700 p-8 shadow-2xl backdrop-blur-xl md:grid-cols-[1.15fr_0.85fr] md:p-14 ${cardBackground}`}>
            <div className="flex flex-col justify-center">
              <p className="mb-4 text-xs font-bold uppercase tracking-[0.25em] text-[#0B41CD]">Roche Wissenstest</p>
              <h1 className="max-w-xl text-4xl font-bold leading-tight tracking-tight md:text-6xl">Doing now what patients <span className="font-[Georgia] text-[#0B41CD] italic tracking-wide">need next.</span></h1>
              <p className={`mt-6 max-w-lg text-lg leading-8 ${mutedText}`}>Wie gut kennst du Roche? Entdecke die Geschichte, Forschung und Ideen hinter einem weltweit tätigen Gesundheitsunternehmen.</p>
              <div className={`mt-8 flex gap-3 text-sm font-semibold ${mutedText}`}><span>07 Fragen</span><span>·</span><span>ca. 1 Minute</span></div>
            </div>
            <form className={`flex flex-col justify-center rounded-3xl border p-6 shadow-inner ${darkMode ? "border-[#4C5456] bg-[#4C5456]/35" : "border-[#BABABA] bg-[#BABABA]/20"}`} onSubmit={startQuiz}>
              <label htmlFor="name" className="font-semibold">Wie heißt du?</label>
              <input id="name" type="text" value={name} onChange={(event) => { setName(event.target.value); setNameError(""); setResetMessage(""); }} placeholder="Dein Vorname" maxLength={25} autoComplete="given-name" required className={`mt-3 rounded-xl border px-4 py-3 outline-none ring-[#0B41CD]/30 transition focus:ring-4 ${darkMode ? "border-[#4C5456] bg-[#4C5456] text-white placeholder:text-slate-400" : "border-[#BABABA] bg-white text-slate-900"}`} />
              {nameError && <p className="mt-2 text-sm font-medium text-[#000000]">{nameError}</p>}
              {resetMessage && <p className="mt-2 text-sm font-medium text-[#0B41CD]">{resetMessage}</p>}
              <button className="mt-5 rounded-xl bg-[#0B41CD] px-5 py-3 font-semibold text-white transition hover:-translate-y-0.5 hover:bg-[#0B41CD]" type="submit">Test starten <span aria-hidden="true">→</span></button>
              <small className={`mt-3 text-center ${mutedText}`}>Keine Anmeldung nötig.</small>
              <button type="button" onClick={resetStoredNames} className={`mt-2 text-xs underline transition hover:text-[#0B41CD] ${mutedText}`}>Gespeicherte Daten zurücksetzen</button>
            </form>
          </div>
        ) : showQuizSelection ? (
          <div className={`w-full max-w-3xl rounded-[2rem] border border-t-4 border-t-blue-700 p-8 text-center shadow-2xl backdrop-blur-xl md:p-12 ${cardBackground}`}>
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-[#0B41CD]">Quiz auswählen</p>
            <h1 className="mt-3 text-4xl font-bold tracking-tight">Welches Quiz möchtest du spielen?</h1>
            <p className={`mx-auto mt-4 max-w-xl ${mutedText}`}>Wähle ein Quiz aus. Weitere Quizze sind als Platzhalter vorbereitet.</p>
            <div className="mt-8 grid gap-4 sm:grid-cols-2">
              <button type="button" onClick={selectRocheQuiz} className="rounded-2xl bg-[#0B41CD] px-5 py-6 text-lg font-bold text-white shadow-lg transition hover:-translate-y-1 hover:bg-[#0B41CD]">Roche Quiz</button>
              <button type="button" onClick={selectMedicationQuiz} className="rounded-2xl bg-[#0B41CD] px-5 py-6 text-lg font-bold text-white shadow-lg transition hover:-translate-y-1 hover:bg-[#0B41CD]">Roche Medikamente Quiz</button>
              <button type="button" disabled className="cursor-not-allowed rounded-2xl bg-blue-300 px-5 py-6 text-lg font-bold text-white opacity-70">Quiz Platzhalter 3</button>
              <button type="button" disabled className="cursor-not-allowed rounded-2xl bg-blue-300 px-5 py-6 text-lg font-bold text-white opacity-70">Quiz Platzhalter 4</button>
            </div>
          </div>
        ) : finished ? (
          <div className={`w-full max-w-2xl rounded-[2rem] border border-t-4 border-t-blue-700 p-8 text-center shadow-2xl backdrop-blur-xl md:p-14 ${cardBackground}`}>
            {/* Zeigt das Ergebnis und bietet einen Neustart an. */}
            <p className="text-xs font-bold uppercase tracking-[0.25em] text-[#0B41CD]">Wissenstest abgeschlossen</p>
            <div className="my-8"><strong className="text-7xl font-bold text-[#0B41CD]">{score}<small className={`text-3xl ${mutedText}`}> / {questions.length}</small></strong><span className={`mt-2 block ${mutedText}`}>richtige Antworten</span></div>
            <h1 className="text-3xl font-bold">Danke, {name.trim()}!</h1>
            <p className={`mt-3 ${mutedText}`}>Du hast {score} von {questions.length} Roche-Fragen richtig beantwortet.</p>
            {savedResult && <p className="mt-4 text-lg font-semibold text-[#0B41CD]">Dein Rang: {savedResult.rank}. Platz · Zeit: {formatDuration(savedResult.durationMs)}</p>}
            <div className="my-8 text-left" aria-label={`Ergebnis: ${scorePercentage} Prozent`}>
              <div className={`mb-2 flex justify-between text-sm font-semibold ${mutedText}`}><span>Dein Ergebnis</span><span>{scorePercentage}%</span></div>
              <div className={`result-progress h-5 overflow-hidden rounded-full ${darkMode ? "bg-[#4C5456]" : "bg-[#BABABA]"}`}>
                <span className="result-progress-fill block h-full rounded-full bg-gradient-to-r from-[#0B41CD] via-[#0B41CD] to-[#0B41CD]/40" style={{ width: `${scorePercentage}%` }} />
              </div>
            </div>
            <button type="button" onClick={() => setShowMistakes((value) => !value)} className={`mb-6 rounded-xl border px-5 py-3 font-semibold transition hover:border-[#0B41CD] hover:text-[#0B41CD] hover:shadow-[0_0_18px_rgba(11,65,205,0.5)] ${darkMode ? "border-[#4C5456]" : "border-[#BABABA]"}`}>{showMistakes ? "Fehler ausblenden" : "Fehler anzeigen"}</button>
            {showMistakes && (
              <div className={`mb-8 space-y-4 rounded-2xl border p-5 text-left ${darkMode ? "border-[#4C5456] bg-[#4C5456]/35" : "border-[#BABABA] bg-[#BABABA]/20"}`}>
                <h2 className="font-bold text-[#0B41CD]">Deine Fehler</h2>
                {questions.map((item, index) => answersByQuestion[index] === false && <div key={item.question} className={`rounded-xl border p-4 text-sm ${darkMode ? "border-[#4C5456]" : "border-[#BABABA]"}`}><p className="font-semibold">{item.question}</p><p className={`mt-2 ${mutedText}`}>Deine Antwort: {responsesByQuestion[index] ?? "Keine Antwort"}</p><p className="mt-1 text-[#0B41CD]">Richtige Lösung: {item.inputType === "estimate" ? "ca. 100–1.000 Millionen Packungen und 30–80 Milliarden CHF Umsatz" : item.answers.find((answer) => answer.correct)?.text}</p></div>)}
                {score === questions.length && <p className="text-sm text-[#0B41CD]">Alle Antworten waren richtig.</p>}
              </div>
            )}
            <div className="flex flex-wrap justify-center gap-3">
              <button className="primary-action rounded-xl bg-[#0B41CD] px-6 py-3 font-semibold text-white transition" onClick={restart}>Nochmal starten <span>↻</span></button>
              <button type="button" onClick={() => setShowRanking(true)} className={`rounded-xl border px-6 py-3 font-semibold transition hover:border-[#0B41CD] hover:text-[#0B41CD] hover:shadow-[0_0_18px_rgba(11,65,205,0.5)] ${darkMode ? "border-[#4C5456]" : "border-[#BABABA]"}`}>Rangliste ansehen</button>
            </div>
          </div>
        ) : (
          <div className={`w-full max-w-4xl rounded-[2rem] border border-t-4 border-t-blue-700 p-8 shadow-2xl backdrop-blur-xl md:p-14 ${cardBackground}`}>
            {/* Während des Quiz: Fortschritt, Video, Frage und Antworten anzeigen. */}
            <div className="flex items-start justify-between gap-4"><div><p className="text-xs font-bold uppercase tracking-[0.2em] text-[#0B41CD]">Roche Wissenstest · {name.trim()}</p><h1 className="mt-3 text-3xl font-bold md:text-5xl">Deine nächste Frage</h1></div><div className="text-right"><strong className="text-4xl text-[#0B41CD]">{String(current + 1).padStart(2, "0")}</strong><span className={`block text-sm ${mutedText}`}>/ {String(questions.length).padStart(2, "0")}</span><span className={`mt-2 block text-xs font-semibold ${mutedText}`}>Zeit {formatDuration(elapsedSeconds * 1000)}</span></div></div>
            <div className={`mt-8 h-2 overflow-hidden rounded-full ${darkMode ? "bg-[#4C5456]" : "bg-[#BABABA]"}`}><span className="block h-full rounded-full bg-[#0B41CD] transition-all duration-300" style={{ width: `${progress}%` }} /></div>
            <p className="mt-10 text-2xl font-semibold leading-relaxed md:text-3xl">{question.question}</p>
            {showFoundingVideo && (
              <div className="mt-6 overflow-hidden rounded-2xl border border-[#BABABA] bg-black shadow-lg">
                <video className="aspect-video w-full" controls preload="metadata" title="Screenrecording zur Gründung von Roche">
                  <source src="/roche-gruendung.mp4" type="video/mp4" />
                  Dein Browser unterstützt dieses Videoformat nicht.
                </video>
              </div>
            )}
            {question.inputType === "estimate" ? (
              <form className={`mt-8 grid gap-5 rounded-2xl border p-6 ${darkMode ? "border-[#4C5456] bg-[#4C5456]/35" : "border-[#BABABA] bg-[#BABABA]/20"}`} onSubmit={submitEstimate}>
                <p className={`text-sm ${mutedText}`}>Gib deine Schätzung in Millionen Packungen und Milliarden CHF ein. Eine Antwort gilt als richtig, wenn beide Werte ungefähr in der plausiblen Größenordnung liegen.</p>
                <label className="grid gap-2 font-semibold">Packungen pro Jahr (in Millionen)<input type="number" min="0" value={estimateProduction} onChange={(event) => setEstimateProduction(event.target.value)} className={`rounded-xl border px-4 py-3 outline-none ring-[#0B41CD]/30 focus:ring-4 ${darkMode ? "border-[#4C5456] bg-[#4C5456] text-white" : "border-[#BABABA] bg-white text-black"}`} required /></label>
                <label className="grid gap-2 font-semibold">Umsatz durch Verkäufe (in Milliarden CHF)<input type="number" min="0" value={estimateRevenue} onChange={(event) => setEstimateRevenue(event.target.value)} className={`rounded-xl border px-4 py-3 outline-none ring-[#0B41CD]/30 focus:ring-4 ${darkMode ? "border-[#4C5456] bg-[#4C5456] text-white" : "border-[#BABABA] bg-white text-black"}`} required /></label>
                <button type="submit" className="rounded-xl bg-[#0B41CD] px-5 py-3 font-semibold text-white transition hover:bg-[#0B41CD]">Schätzung abgeben <span aria-hidden="true">→</span></button>
              </form>
            ) : (
              <div className="mt-8 grid gap-4 md:grid-cols-2" role="group" aria-label="Antwortmöglichkeiten">{question.answers.map((answer, index) => <button key={answer.text} className={`flex min-h-20 items-center gap-4 rounded-2xl border-2 px-5 py-4 text-left font-medium transition hover:-translate-y-0.5 ${answerColors[index]} ${isDevMode && answer.correct ? "font-extrabold" : ""}`} onClick={() => chooseAnswer(index)}><span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/80 text-sm font-bold text-[#4C5456]">{answerLetters[index]}</span><span>{answer.text}</span></button>)}</div>
            )}
            <div className={`mt-8 flex flex-col gap-4 border-t pt-6 text-sm sm:flex-row sm:items-center sm:justify-between ${darkMode ? "border-[#4C5456] text-[#BABABA]" : "border-[#BABABA] text-[#4C5456]"}`}>
              <span>Wähle eine Antwort aus, um automatisch weiterzugehen.</span>
              {current > 0 && <button type="button" onClick={() => setCurrent((value) => value - 1)} className="font-semibold text-[#0B41CD] transition hover:text-blue-900">← Zurück</button>}
            </div>
          </div>
        )}
      </section>

      {/* Fußzeile mit Projektname, Slogan und Night-Mode-Umschalter. */}
      <footer className={`relative z-10 mx-auto flex w-full max-w-6xl flex-wrap items-center justify-between gap-3 px-6 pb-6 text-xs ${mutedText} lg:px-10`}><span>Roche Wissenstest</span><span>Doing now what patients need next.</span><div className="flex items-center gap-4"><button type="button" onClick={() => setShowRanking((value) => !value)} className="font-semibold transition hover:text-[#0B41CD]">Rangliste</button><button type="button" onClick={() => setDarkMode((value) => !value)} className="font-semibold transition hover:text-[#0B41CD]" aria-label={darkMode ? "Light mode aktivieren" : "Dark mode aktivieren"}>{darkMode ? "☀ Light mode" : "☾ Night mode"}</button></div></footer>
    </main>
  );
}
