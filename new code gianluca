    setCurrent(0);
    setAnswersByQuestion(Array(sourceQuestions.length).fill(null));
    setResponsesByQuestion(Array(sourceQuestions.length).fill(null));
    setShowMistakes(false);
    setFinished(false);
    setSavedResult(null);
    setShowRanking(false);
    setShowQuizSelection(true);
