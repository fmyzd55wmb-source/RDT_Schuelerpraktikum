// Mischt eine Liste, ohne das ursprüngliche Array zu verändern.
function shuffle<T>(items: T[]) {
  return [...items].sort(() => Math.random() - 0.5);
}

// Setzt die Gründungsfrage an die erste Stelle und mischt den Rest.
function createQuiz(questionSet: Question[] = sourceQuestions, keepFirst = questionSet === sourceQuestions) {
  const orderedQuestions = keepFirst ? [questionSet[0], ...shuffle(questionSet.slice(1))] : shuffle(questionSet);

  return orderedQuestions.map((question) => ({
    ...question,
    answers: shuffle(question.answers),
  }));
}

// Liest bereits verwendete Namen aus localStorage; beim ersten Laden gibt es eine leere Liste.
function getStoredNames(): string[] {
  if (typeof window === "undefined") return [];
  const savedNames = window.localStorage.getItem(USED_NAMES_KEY);
  if (!savedNames) return [];

  try {
    const names = JSON.parse(savedNames);
    return Array.isArray(names) ? names.filter((name): name is string => typeof name === "string") : [];
  } catch {
    window.localStorage.removeItem(USED_NAMES_KEY);
    return [];
  }
}

function readResults(): QuizResult[] {
  if (typeof window === "undefined") return [];
  try {
    const savedResults = window.localStorage.getItem(RESULTS_KEY);
    const parsed = savedResults ? JSON.parse(savedResults) : [];
    return Array.isArray(parsed) ? parsed.filter((result): result is QuizResult => result && typeof result.name === "string" && typeof result.correct === "number").map((result) => ({ ...result, quiz: result.quiz === "medication" ? "medication" : "roche", durationMs: typeof result.durationMs === "number" ? result.durationMs : null, attempts: typeof result.attempts === "number" ? result.attempts : 1 })) : [];
  } catch {
    return [];
  }
}

function normalizeName(value: string): string {
  return value.trim().toLocaleLowerCase("de-DE");
}

function sortResults(results: QuizResult[]): QuizResult[] {
  return [...results].sort((first, second) => second.correct - first.correct || (first.durationMs ?? Number.MAX_SAFE_INTEGER) - (second.durationMs ?? Number.MAX_SAFE_INTEGER) || new Date(first.completedAt).getTime() - new Date(second.completedAt).getTime());
}

function formatDuration(durationMs: number | null): string {
  if (durationMs === null) return "—";
  const totalSeconds = Math.round(durationMs / 1000);
  const minutes = Math.floor(totalSeconds / 60);
  const seconds = String(totalSeconds % 60).padStart(2, "0");
  return `${minutes}:${seconds} min`;
}

function rankResults(results: QuizResult[]): QuizResult[] {
  return sortResults(results).map((result, index) => ({ ...result, rank: index + 1 }));
}

function buildOverallResults(results: QuizResult[]): QuizResult[] {
  const grouped = new Map<string, QuizResult[]>();
  results.filter((result) => result.quiz !== "overall").forEach((result) => {
    const key = normalizeName(result.name);
    grouped.set(key, [...(grouped.get(key) ?? []), result]);
  });

  return Array.from(grouped.values()).map((entries) => {
    const first = entries[0];
    const totalCorrect = entries.reduce((sum, entry) => sum + entry.correct, 0);
    const totalTime = entries.reduce((sum, entry) => sum + (entry.durationMs ?? 0), 0);
    const totalAttempts = entries.reduce((sum, entry) => sum + entry.attempts, 0);
    return {
      id: `overall-${normalizeName(first.name)}`,
      name: first.name,
      quiz: "overall",
      correct: totalCorrect,
      total: sourceQuestions.length + medicationQuestions.length,
      percentage: Math.round((totalCorrect / (sourceQuestions.length + medicationQuestions.length)) * 100),
      completedAt: entries.reduce((latest, entry) => entry.completedAt > latest ? entry.completedAt : latest, first.completedAt),
      durationMs: totalTime || null,
      attempts: totalAttempts,
      rank: 0,
    };
  });
}

