  const ranking = useMemo(() => rankingScope === "overall" ? rankResults(buildOverallResults(results)) : rankResults(results.filter((result) => result.quiz === rankingScope)), [results, rankingScope]);

  useEffect(() => {
    if (!finished || savedResult || !name.trim()) return;

    const saveTimer = window.setTimeout(() => {
      const previousResult = results.find((item) => item.quiz === quizMode && normalizeName(item.name) === normalizeName(name));
      const currentDuration = quizStartedAt === null ? null : Date.now() - quizStartedAt;
      const isBetterAttempt = !previousResult || score > previousResult.correct || (score === previousResult.correct && currentDuration !== null && (previousResult.durationMs === null || currentDuration < previousResult.durationMs));
      const bestScore = isBetterAttempt ? score : previousResult?.correct ?? score;
      const result: QuizResult = {
        id: previousResult?.id ?? `${Date.now()}-${quizMode}-${name.trim()}`,
        name: name.trim(),
        quiz: quizMode,
        correct: bestScore,
        total: questions.length,
        percentage: Math.round((bestScore / questions.length) * 100),
        completedAt: new Date().toISOString(),
        durationMs: isBetterAttempt ? currentDuration : previousResult?.durationMs ?? currentDuration,
        attempts: (previousResult?.attempts ?? 0) + 1,
        rank: 0,
      };
      const nextResults = rankResults([...results.filter((item) => item.quiz !== result.quiz || normalizeName(item.name) !== normalizeName(result.name)), result]);
      const currentResult = nextResults.find((item) => item.id === result.id) ?? result;

      try {
        window.localStorage.setItem(RESULTS_KEY, JSON.stringify(nextResults));
      } catch {
        // Das Quiz funktioniert auch, wenn der Browser keinen Speicher erlaubt.
      }
      setResults(nextResults);
      setSavedResult(currentResult);
    }, 0);

    return () => window.clearTimeout(saveTimer);
  }, [finished, name, questions.length, quizMode, quizStartedAt, results, savedResult, score]);

  // Aktualisiert die sichtbare Quizzeit einmal pro Sekunde.
