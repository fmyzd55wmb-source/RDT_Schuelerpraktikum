// Eine Antwort enthält den sichtbaren Text und die Information, ob sie richtig ist.
type Answer = { text: string; correct: boolean };
// Eine Frage besteht aus dem Fragetext und vier Antwortmöglichkeiten.
type Question = { question: string; answers: Answer[]; inputType?: "estimate" };
type QuizResult = { id: string; name: string; quiz: "roche" | "medication" | "overall"; correct: number; total: number; percentage: number; completedAt: string; durationMs: number | null; attempts: number; rank: number };
type RankingScope = "overall" | "roche" | "medication";

